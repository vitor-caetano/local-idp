{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schema/devbox.schema.json",
  "packages": {
    "kubectl":         "1.36.3",
    "kubernetes-helm": "4.3.0",
    "nodejs":          "24.20.0",
    "uv":              "0.12.17",
    "go":              "1.27.1",
    "git":             "latest",
    "curl":            "latest",
    "perl":            "latest"
  },
  "env": {
    "KUBECONFIG":                      "$HOME/.kube/local-idp",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "shell": {
    "init_hook": [
      "export PATH=\"$DEVBOX_PROJECT_ROOT/.devbox/bin:$PATH\"",
      "./scripts/install-kind.sh",
      "corepack enable --install-directory \"$DEVBOX_PROJECT_ROOT/.devbox/bin\""
    ],
    "scripts": {
      "test":          "uv run --group test pytest",
      "test-cluster":  "KUBECONFIG_FILE=\"$KUBECONFIG\" EXPECTED_CONTEXT=kind-local-idp uv run --group test pytest -v",
      "check-context": "test \"$(kubectl config current-context)\" = kind-local-idp && echo kind-local-idp",
      "inotify":       "rdctl shell sudo sysctl -w fs.inotify.max_user_instances=512 fs.inotify.max_user_watches=524288"
    }
  }
}
